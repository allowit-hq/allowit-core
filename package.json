{
  "name": "@allowit/core",
  "version": "0.4.0",
  "type": "module",
  "description": "Common Allowit policy values and canonical function metadata",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allowit-hq/allowit-core.git"
  },
  "exports": {
    ".": {
      "types": "./typescript/core.d.ts",
      "default": "./typescript/core.js"
    },
    "./core": {
      "types": "./typescript/core.d.ts",
      "default": "./typescript/core.js"
    }
  },
  "files": [
    "typescript/core.js",
    "typescript/core.d.ts",
    "typescript/canonical-functions.json",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-presentation.mjs",
    "check": "node scripts/generate-presentation.mjs --check",
    "test": "node --test tests/presentation/package.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0"
}
